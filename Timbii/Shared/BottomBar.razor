<footer class="bottom-bar @Page @Styles">
    @ChildContent

    @if (Styles.Contains("footer-menu"))
    {
        <NavLink class="nav-link friends-btn" href="/friends" ActiveClass="active" Match="NavLinkMatch.Prefix">
            <FriendsIcon Color="var(--egg-50)" />
            <span>Friends</span>
        </NavLink>

        <NavLink class="nav-link chats-btn" href="/chats" ActiveClass="active" Match="NavLinkMatch.Prefix">
            <ChatsIcon Color="var(--egg-50)" />
            <span>Chats</span>
        </NavLink>
        <NavLink class="nav-link settings-btn" href="/settings" ActiveClass="active" Match="NavLinkMatch.Prefix">
            <MoreSettingsIcon Color="var(--egg-50)" />
            <span>More</span>
        </NavLink>
    }
</footer>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public required string Page { get; set; }
    [Parameter] public string Styles { get; set; } = "";
}