@page "/chats/{RoomId}"
@layout AppLayout

<TopBar Page="chat-page" Styles="height-80 cols-2">
    <div class="left">
        <button class="back-btn icon-btn" @onclick='() => Nav.NavigateTo("/chats")'><ChevronLeftIcon /></button>
        <div class="user-card">
            <div class="user-img">
            </div>
            <div class="user-info">
                <h3>@(Room != null ? (Room.Name ?? $"{Room.RoomId.Substring(0, 10)}...") : "")</h3>
                <aside>@(Room != null ? Room.Topic : "")</aside>
            </div>
        </div>
    </div>
    <div class="right chat-actions">
        <SparcAura>
            <Presence Avatar="context" />
        </SparcAura>
        <button class="more-btn icon-btn" @onclick='() => Nav.NavigateTo($"/chats/{RoomId}/settings")'><MenuIcon /></button>
    </div>
</TopBar>

<main>
    <div class="message-list @(showMessages ? "show" : "")">
        @foreach (var msg in Messages)
        {
            <div class="message-container @(IsUserMessage(msg.Sender) ? "my-message" : "")">
                <MessageCard Message=@msg IsMine=IsUserMessage(msg.Sender) OnOptionsClicked=ToggleOptions />
            </div>
        }
    </div>
</main>

<ChatBar OnSendMessage=SendMessage MessageSent=messageSent />

@if (showMessageOptions && (ActiveMessage != null))
{
    <MessageOptions Message=ActiveMessage OnClose=ToggleOptions OnViewOriginal=ViewOriginal OnPin=Pin OnCopy=Copy OnSelectAndCopy=SelectAndCopy OnReply=Reply />
}

@code {
    [CascadingParameter] public BlossomUser? User { get; set; }
    [Parameter] public required string RoomId { get; set; }

    private List<Message> Messages = [];
    private MatrixRoom? Room { get; set; }

    bool messageSent = false;
    bool showMessages = false;
    bool showMessageOptions = false;
    Message ActiveMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(RoomId))
        {
            Room = await Chats.GetRoomSummaryAsync(RoomId);
            await GetMessagesAsync();
            StateHasChanged();

            if (Messages.Count > 0)
            {
                if (!messageSent && !showMessageOptions)
                {
                    await Js.InvokeVoidAsync("scrollToLastMessage", DotNetObjectReference.Create(this), false);
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Messages.Count > 0)
        {
            if (!showMessageOptions)
            {
                if (messageSent)
                {
                    await Js.InvokeVoidAsync("scrollToLastMessage", DotNetObjectReference.Create(this), true);
                }
                else
                {
                    await Js.InvokeVoidAsync("scrollToLastMessage", DotNetObjectReference.Create(this), false);
                }
            }
        }
    }

    [JSInvokable("ShowMessages")] 
    public void ShowMessages()
    {
        showMessages = true;
    }

    private async Task GetMessagesAsync()
    {
        Messages = await Chats.GetMessagesAsync(Room!.RoomId);
    }

    private async Task SendMessage(string messageText)
    {
        if (!string.IsNullOrWhiteSpace(messageText))
        {
            var txnId = Guid.NewGuid().ToString();
            await Chats.SendMessageAsync(Room!.RoomId, "m.room.message", txnId, new(messageText));

            // currentMessage = "";
            await GetMessagesAsync();
            messageSent = true;
        }
    }

    private bool IsUserMessage(string userId)
    {
        var matrixId = User?.Identities?.FirstOrDefault(x => x.Type == "Matrix")?.Id;
        if (userId == matrixId)
        {
            return true;
        }
        else
        {
            return false;
        }
    }

    private void GoToCreateRoom()
    {
        Nav.NavigateTo("/chats/new");
    }

    void ToggleOptions(Message message)
    {
        showMessageOptions = !showMessageOptions;
        ActiveMessage = message;
    }

    void ViewOriginal()
    {
        Console.WriteLine("View Original clicked");
    }

    void Pin()
    {
        Console.WriteLine("Pin clicked");
    }

    void Copy()
    {
        Console.WriteLine("Copy clicked");
    }

    void SelectAndCopy()
    {
        Console.WriteLine("Select and Copy clicked");
    }

    void Reply()
    {
        Console.WriteLine("Reply clicked");
    }
}