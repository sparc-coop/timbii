@page "/onboarding/language"
@layout AppLayout

<main class="onboarding">
    <OnboardingProgress Step=2 />
    <header>
        <h2>Select Your Language</h2>
        <div class="search-bar language-search">
            <SearchIcon />
            <input type="text" placeholder="Search" @bind=@searchTerm @bind:after=SearchLanguages />
        </div>
    </header>
    <section>
        @if (SelectedLanguage != null)
        {
            <div class="selected-language">
                <div class="left">
                    <h3>@SelectedLanguage.DisplayName</h3>
                    <p>@SelectedLanguage.NativeName</p>
                </div>
                <div class="right">
                    <aside class="check-container">
                        <CheckIcon />
                    </aside>
                </div>
            </div>
        }
        <ul>
            @foreach (var language in FilteredLanguages)
            {
                <li @key=language.Id class="@(SelectedLanguage == language ? "selected" : "")" @onclick='() => UpdateLanguage(language)'>
                    <div class="left">
                        <h3>@language.DisplayName</h3>
                        <p>@language.NativeName</p>
                    </div>
                    <div class="right">
                        @if (SelectedLanguage == language)
                        {
                            <aside class="check-container">
                                <CheckIcon />
                            </aside>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>
</main>

<BottomBar Page="onboarding-language" Styles="onboarding-btns">
    <button class="secondary-btn" @onclick='() => Nav.NavigateTo("/onboarding/about")'>Back</button>
    <button class="primary-btn" @onclick='() => Nav.NavigateTo("/onboarding/tone")'>Next</button>
</BottomBar>

@code {
    [CascadingParameter] public BlossomUser? User { get; set; }

    IEnumerable<Language> Languages { get; set; } = [];
    IEnumerable<Language> FilteredLanguages = [];
    Language? SelectedLanguage;
    string searchTerm = string.Empty;

    //Dictionary<string, string> Languages = new Dictionary<string, string>();

    protected override async Task OnInitializedAsync()
    {
        Languages = await Tovik.GetLanguages();
        FilteredLanguages = Languages;
        SelectedLanguage = User?.Avatar.Language;
        if (SelectedLanguage == null)
        {
            SelectedLanguage = Languages.FirstOrDefault(l => l.Id == "en");
        }
    }

    // protected override void OnInitialized()
    // {
    // Languages.Add("English", "Hello");
    // Languages.Add("Spanish", "Hola");
    // Languages.Add("French", "Bonjour");
    // Languages.Add("Italian", "Ciao");
    // Languages.Add("Portuguese", "Olá");
    // }

    void UpdateLanguage(Language language)
    {
        SelectedLanguage = language;
        if (User != null) User.Avatar.Language = SelectedLanguage;
        StateHasChanged();
    }

    void SearchLanguages()
    {
        if (!string.IsNullOrEmpty(searchTerm))
        {
            FilteredLanguages = Languages.Where(x => (x.Id.ToLower().Contains(searchTerm.ToLower()) || x.DisplayName.ToLower().Contains(searchTerm.ToLower())) || x.NativeName.ToLower().Contains(searchTerm.ToLower()));
        }
        else
        {
            FilteredLanguages = Languages;
        }
    }
}